{
  "name": "@gatling.io/gatling-mcp-server",
  "version": "0.2.1",
  "license": "Apache-2.0",
  "homepage": "https://gatling.io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gatling/gatling-ai-extensions.git"
  },
  "bugs": "https://github.com/gatling/gatling/issues",
  "keywords": [
    "gatling",
    "mcp",
    "model context protocol",
    "ai",
    "llm",
    "claude",
    "chatgpt",
    "test",
    "testing",
    "loadtest",
    "loadtesting",
    "load test",
    "load testing",
    "performance test",
    "performance testing"
  ],
  "type": "module",
  "bin": {
    "gatling-mcp-server": "target/index.js"
  },
  "files": [
    "target"
  ],
  "main": "target/index.js",
  "scripts": {
    "clean": "rimraf target",
    "build": "tsc --project tsconfig.build.json && tsc-alias --project tsconfig.build.json && chmod +x target/index.js && cp src/keycloak.json target/keycloak.json && cp src/oauthMetadata.json target/oauthMetadata.json",
    "format": "prettier --write '**/*.ts'",
    "format-check": "prettier --check '**/*.ts'",
    "start": "npm run build && GATLING_USE_DEV_ENV_ANALYTICS=true ./target/index.js",
    "test": "jest --runInBand"
  },
  "dependencies": {
    "@actions/http-client": "4.0.1",
    "@modelcontextprotocol/server": "2.0.0",
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/express": "2.0.0",
    "express": "5.2.1",
    "jsonwebtoken": "9.0.3",
    "keycloak-connect": "26.1.1",
    "uuid": "14.0.2",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.13.3",
    "@types/jest": "30.0.0",
    "@types/jsonwebtoken": "9.0.10",
    "jest": "30.5.0",
    "prettier": "3.9.6",
    "rimraf": "6.1.3",
    "ts-jest": "29.4.12",
    "tsc-alias": "1.9.2",
    "@typescript/native": "npm:typescript@7.0.2",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  }
}
